rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بررسی نقش کاربر
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'admin@block118.app';
    }

    function isResident() {
      return request.auth != null && 
             request.auth.token.email.matches('^[0-9]{3}@block118.app$');
    }

    function getUserUnit() {
      return request.auth.token.email.split('@')[0]; // مثلا "101"
    }

    // واحدها
    match /units/{unitId} {
      // فقط ادمین می‌تواند لیست کامل واحدها را بگیرد
      allow list: if isAdmin();
      
      // خواندن واحد: ادمین همه، ساکن فقط واحد خودش
      allow get: if isAdmin() || 
                    (isResident() && resource.data.unitNumber == getUserUnit());
      
      // ویرایش: فقط ادمین
      allow create, update, delete: if isAdmin();
    }

    // درخواست‌های تعمیر
    match /requests/{requestId} {
      // ادمین همه را می‌بیند، ساکن فقط درخواست‌های خودش
      allow list: if isAdmin() || 
                     (isResident() && resource.data.unit == getUserUnit());
      
      allow get: if isAdmin() || 
                   (isResident() && resource.data.unit == getUserUnit());
      
      // ساخت درخواست با اعتبارسنجی کامل
      allow create: if isResident() &&
                       request.resource.data.unit == getUserUnit() &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() > 0 &&
                       request.resource.data.title.size() <= 100 &&
                       request.resource.data.description is string &&
                       request.resource.data.description.size() <= 2000 &&
                       request.resource.data.createdAt is timestamp;
      
      // تغییر وضعیت: فقط ادمین
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // شارژها (آینده)
    match /charges/{chargeId} {
      allow list, get: if isAdmin() || 
                          (isResident() && resource.data.unitNumber == getUserUnit());
      allow write: if isAdmin();
    }

    // اطلاعیه‌ها (آینده)
    match /announcements/{annId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
